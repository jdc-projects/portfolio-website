# PostHog analytics + error tracking.
# When NEXT_PUBLIC_POSTHOG_KEY is unset, the SDK stays disabled (no-op) — this is
# the default for local dev and the CI test build, keeping them out of prod data.
#
# Production values are injected at build time in GitHub Actions (repo secrets),
# not from this file.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
